# ===== OCR プロバイダ =====
# mock | google | azure  (未設定の場合はキーの有無から自動判定し、最終的に mock)
OCR_PROVIDER=mock

# --- Google Cloud Vision を使う場合 ---
# https://console.cloud.google.com/apis/credentials で発行した APIキー
GOOGLE_VISION_API_KEY=

# --- Azure Computer Vision (Read API) を使う場合 ---
AZURE_VISION_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_VISION_KEY=

# ===== LLM フォールバック (Claude API) =====
# 未設定の場合、ルールベースで確定できなかったフレームは low-confidence のまま出力されます
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
